# Copy to config.env (gitignored) and export before running:
#   set -a; source config/config.env; set +a
#
# Scripts still contain lab defaults in their 配置区. Exporting these
# variables overrides paths that use ${VAR:-default}. For scripts that
# hard-code ROOT="/path/...", edit the 配置区 at the top of that script.

# ---- work directory (assemblies, BAMs, annotation outputs) ----
ROOT=/path/to/workdir
SAMPLES="KD35_primary N2L_primary"
THREADS=32

# ---- conda ----
ANACONDA=/path/to/anaconda3/envs
CONDA_BRAKER=${ANACONDA}/braker3
CONDA_EDTA=${ANACONDA}/EDTA
CONDA_BUSCO=${ANACONDA}/qc_busco
CONDA_MERQURY=${ANACONDA}/qc_merqury
CONDA_QUAST=${ANACONDA}/qc_quast
CONDA_SYNTENY=${ANACONDA}/qc_synteny
CONDA_HIC=${ANACONDA}/hic_tools

# ---- third-party binaries (not always in conda) ----
YAHS=/path/to/yahs/yahs
YAHS_JUICER=/path/to/yahs/juicer
JUICER_TOOLS=/path/to/juicer_tools.1.9.9_jcuda.0.8.jar
LR_GAPCLOSER=/path/to/LR_Gapcloser/src/LR_Gapcloser.sh
QUARTET=/path/to/quarTeT/quartet.py
GENEMARK_PATH=/path/to/GeneMark-ETP-main/bin
PROTHINT_PATH=/path/to/ProtHint/bin
INTERPROSCAN_BIN=/path/to/interproscan.sh

# ---- reference genomes and protein databases ----
REF_WM82=/path/to/Wm82.a2.v1.fasta
REF_ZH13=/path/to/ZH13.v2.fasta
PROT_DB=/path/to/Viridiplantae.fa
PROT_DMND=/path/to/Viridiplantae.dmnd
SWISSPROT_DMND=/path/to/uniprot_sprot.dmnd
BUSCO_LINEAGE=/path/to/busco_downloads/lineages/embryophyta_odb10
REF_PROT_SEARCH=/path/to/blastdb/prot

# soybean reference proteomes used in 09 polish (ZH13 v2/v3 + Wm82)
#   ZH13.v2.prot.fasta
#   ZH13v3.0_mRNA_nuclear_20250729_pro.fasta
#   Wm82.a2.v1.prot.fasta
#   glyma.Wm82.gnm4.ann1.T8TQ.protein.faa
#   glyma.Wm82.gnm6.ann1.PKSW.protein.faa

# ---- RNA-seq (Atlas paired-end, after cleaning) ----
RNA_DIR=${ROOT}/rna_clean

# ---- publication HC filter (09 polish) ----
PUB_NUCLEAR_ONLY=1
PUB_MIN_ZH13_PIDENT=50
PUB_MIN_CONFIDENCE=medium_confidence
PUB_MAX_TE_RATIO=0.5
PUB_REQUIRE_EXPRESSION=0
PUB_MIN_AA=29
